#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_1 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <1 2 3 4>;
        };

        bt_2 {
            bindings = <&bt BT_SEL 4>;
            key-positions = <7 8 9 10>;
        };

        cancel_term {
            bindings = <&kp LC(C)>;
            key-positions = <6 5>;
        };

        paste {
            bindings = <&kp RG(V)>;
            key-positions = <3 4>;
        };

        copy {
            bindings = <&kp RG(C)>;
            key-positions = <16 15>;
        };

        cut {
            bindings = <&kp RG(X)>;
            key-positions = <28 27>;
        };
    };

    macros {
        long_word: long_word {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(T) &kp E &kp X &kp A &kp S &kp LS(C) &kp O &kp D &kp I &kp N &kp G>;
            label = "LONG_WORD";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            label = "Base";
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E  &kp R        &kp T       &kp Y                    &kp U            &kp I             &kp O   &kp P              &kp F18
&kp TAB    &kp A  &kp S  &kp D  &lt 3 F      &kp G       &kp H                    &kp J            &kp K             &kp L   &kp RIGHT_GUI      &kp RC(B)
&sk LSHFT  &kp Z  &kp X  &kp C  &kp V        &kp B       &kp N                    &kp M            &trans            &trans  &kp RIGHT_CONTROL  &trans
                         &sl 4  &lt 2 SPACE  &kp LALT    &mt RIGHT_COMMAND ENTER  &lt 1 BACKSPACE  &mt RCTRL DELETE
            >;
        };

        NUMBER2 {
            bindings = <
&trans  &kp PLUS   &trans  &kp KP_N7        &kp KP_N8        &kp KP_N9          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp EQUAL  &trans  &kp KP_N4        &kp KP_NUMBER_5  &kp KP_NUMBER_6    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp MINUS  &trans  &kp KP_N1        &kp KP_N2        &kp KP_N3          &trans  &trans  &trans  &trans  &trans  &trans
                           &kp KP_NUMBER_0  &kp KP_N0        &kp DOT            &trans  &trans  &trans
            >;

            label = "NUMBER2";
        };

        SYMBOL {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            label = "SYMBOL";
            bindings = <
&kp CARET      &kp SINGLE_QUOTE   &trans  &trans  &mt LEFT_BRACE LESS_THAN  &kp SLASH        &kp EXCLAMATION  &mt RIGHT_BRACE GT     &mt SEMICOLON COLON  &kp ASTERISK      &kp PLUS   &kp AT
&kp DOLLAR     &kp DOUBLE_QUOTES  &trans  &trans  &kp LEFT_PARENTHESIS      &kp PIPE         &kp PERIOD       &kp RIGHT_PARENTHESIS  &kp MINUS            &kp PERCENT       &kp EQUAL  &kp TILDE
&kp LS(POUND)  &kp GRAVE          &trans  &trans  &kp LEFT_BRACKET          &kp BACKSLASH    &kp QUESTION     &kp RIGHT_BRACKET      &kp UNDERSCORE       &kp LA(NUMBER_3)  &kp COMMA  &kp AMPERSAND
                                          &trans  &trans                    &trans           &trans           &trans                 &trans
            >;
        };

        UTILITY {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    |BTCLR|     | SPC |   | ENT |     | ALT |

            label = "UTILITY";
            bindings = <
&kp C_BRIGHTNESS_INC  &trans  &trans  &trans  &trans    &trans      &trans                 &trans                   &trans  &trans     &kp RG(PLUS)   &kp C_VOLUME_UP
&kp C_BRIGHTNESS_DEC  &trans  &trans  &trans  &trans    &trans      &kp LEFT               &kp DOWN                 &kp UP  &kp RIGHT  &kp RG(MINUS)  &kp C_VOL_DN
&trans                &trans  &trans  &trans  &trans    &trans      &trans                 &trans                   &trans  &trans     &trans         &kp K_MUTE
                                      &trans  &mkp MB4  &mkp MB5    &mt RG(LEFT) LA(LEFT)  &mt RG(RIGHT) RA(RIGHT)  &trans
            >;
        };

        CONTROL {
            bindings = <
&kp RG(LS(NUMBER_4))  &kp RG(W)  &trans  &trans  &trans     &trans       &trans     &trans         &trans     &trans     &trans     &kp F11
&trans                &trans     &trans  &trans  &kp RG(F)  &kp RG(N)    &trans     &kp RA(C)      &kp LA(M)  &kp LA(N)  &kp LA(W)  &kp RG(SPACE)
&trans                &trans     &trans  &trans  &trans     &trans       &kp RG(N)  &kp LA(TAB)    &trans     &trans     &trans     &long_word
                                         &trans  &trans     &kp RG(S)    &kp RG(Z)  &kp RG(LS(Z))  &trans
            >;

            label = "CONTROL";
        };
    };
};
