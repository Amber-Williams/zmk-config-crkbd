#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            label = "Base";
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E        &kp R        &kp T       &kp Y    &kp U          &kp I              &kp O          &kp P          &kp F18
&kp TAB    &kp A  &kp S  &kp D        &lt 1 F      &kp G       &kp H    &kp J          &kp K              &kp L          &mo 4          &kp RC(B)
&kp LSHFT  &kp Z  &kp X  &mt LCTRL C  &kp V        &kp B       &kp N    &kp M          &kp RIGHT_CONTROL  &kp RIGHT_ALT  &kp RIGHT_GUI  &kp F19
                         &mo 3        &lt 2 SPACE  &kp LALT    &kp RET  &kp BACKSPACE  &mo 3
            >;
        };

        system {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    |BTCLR|     | SPC |   | ENT |     | ALT |

            label = "system";
            bindings = <
&kp C_BRIGHTNESS_INC  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans    &trans    &trans  &trans     &kp RG(PLUS)   &kp C_VOLUME_UP
&kp C_BRIGHTNESS_DEC  &trans        &trans        &trans        &trans        &trans          &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp RG(MINUS)  &kp C_VOL_DN
&trans                &trans        &trans        &trans        &trans        &trans          &trans    &trans    &trans  &trans     &trans         &kp K_MUTE
                                                  &trans        &trans        &trans          &trans    &trans    &trans
            >;
        };

        sym {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            label = "sym";
            bindings = <
&trans  &kp CARET      &kp DOLLAR        &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SLASH        &kp EXCLAMATION  &kp SINGLE_QUOTE   &mt SEMICOLON COLON  &kp ASTERISK  &kp PLUS   &kp AT
&trans  &trans         &kp LS(POUND)     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE         &kp PERIOD       &kp DOUBLE_QUOTES  &kp MINUS            &kp PERCENT   &kp EQUAL  &kp TILDE
&trans  &kp LESS_THAN  &kp GREATER_THAN  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp BACKSLASH    &kp QUESTION     &kp GRAVE          &kp UNDERSCORE       &kp POUND     &kp COMMA  &kp AMPERSAND
                                         &trans                &trans                 &trans           &trans           &kp DEL            &trans
            >;
        };

        nav {
            bindings = <
&trans  &kp RG(W)  &trans     &trans     &kp RG(LEFT_BRACKET)  &trans    &trans                               &kp RG(RIGHT_BRACKET)  &trans                &trans                           &trans         &trans
&trans  &kp LG(A)  &kp RG(S)  &trans     &kp RG(F)             &trans    &mt LC(A) LA(LEFT)                   &mt RG(DOWN) DOWN      &mt RG(UP) UP_ARROW   &mt LC(E) LA(RIGHT)              &trans         &trans
&trans  &kp RG(Z)  &kp RG(X)  &kp RG(C)  &kp RG(V)             &trans    &mt LS(LG(LEFT_ARROW)) LS(LA(LEFT))  &kt LS(LA(DOWN))       &kp LS(LA(UP_ARROW))  &mt LS(LG(RIGHT)) LS(LA(RIGHT))  &kp RG(RS(Z))  &trans
                              &trans     &trans                &trans    &trans                               &trans                 &trans
            >;
        };

        num {
            bindings = <
&trans  &trans     &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
&trans  &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_N4  &kp KP_N5    &kp KP_N6  &kp KP_N7  &kp KP_N8  &kp KP_N9  &trans  &trans
&trans  &kp KP_N0  &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans  &trans
                              &trans     &trans     &trans       &trans     &trans     &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };
    };
};
