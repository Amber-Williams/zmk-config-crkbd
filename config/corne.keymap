#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_1 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <1 2 3 4>;
        };

        bt_2 {
            bindings = <&bt BT_SEL 4>;
            key-positions = <7 8 9 10>;
        };

        cancel_term {
            bindings = <&kp LC(C)>;
            key-positions = <6 5>;
        };

        num_layer {
            bindings = <&mo 1>;
            key-positions = <19 20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            label = "Base";
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E  &kp R        &kp T       &kp Y                    &kp U          &kp I      &kp O   &kp P          &kp F18
&kp TAB    &kp A  &kp S  &kp D  &lt 3 F      &kp G       &kp H                    &kp J          &kp K      &kp L   &kp RIGHT_GUI  &kp RC(B)
&sk LSHFT  &kp Z  &kp X  &kp C  &kp V        &kp B       &kp N                    &kp M          &trans     &trans  &trans         &trans
                         &sl 4  &lt 2 SPACE  &kp LALT    &mt RIGHT_COMMAND ENTER  &kp BACKSPACE  &kp RCTRL
            >;
        };

        NUMBER2 {
            bindings = <
&trans  &trans  &trans  &kp KP_N7        &kp KP_N8        &kp KP_N9          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp KP_N4        &kp KP_NUMBER_5  &kp KP_NUMBER_6    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp KP_N1        &kp KP_N2        &kp KP_N3          &trans  &trans  &trans  &trans  &trans  &trans
                        &kp KP_NUMBER_0  &kp KP_N0        &trans             &trans  &trans  &trans
            >;

            label = "NUMBER2";
        };

        SYMBOL {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            label = "SYMBOL";
            bindings = <
&kp CARET      &kp SINGLE_QUOTE   &trans  &trans          &kp LESS_THAN         &kp SLASH        &kp EXCLAMATION  &kp GREATER_THAN       &mt SEMICOLON COLON  &kp ASTERISK      &kp PLUS   &kp AT
&kp DOLLAR     &kp DOUBLE_QUOTES  &trans  &trans          &kp LEFT_PARENTHESIS  &kp PIPE         &kp PERIOD       &kp RIGHT_PARENTHESIS  &kp MINUS            &kp PERCENT       &kp EQUAL  &kp TILDE
&kp LS(POUND)  &kp GRAVE          &trans  &trans          &kp LEFT_BRACKET      &kp BACKSLASH    &kp QUESTION     &kp RIGHT_BRACKET      &kp UNDERSCORE       &kp LA(NUMBER_3)  &kp COMMA  &kp AMPERSAND
                                          &kp LEFT_BRACE  &trans                &trans           &trans           &trans                 &kp RIGHT_BRACE
            >;
        };

        UTILITY {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    |BTCLR|     | SPC |   | ENT |     | ALT |

            label = "UTILITY";
            bindings = <
&kp C_BRIGHTNESS_INC  &trans  &trans  &trans  &trans  &trans    &mt RG(LEFT) RA(LEFT_ARROW)  &trans    &trans  &mt RG(RIGHT) RA(RIGHT)  &kp RG(PLUS)   &kp C_VOLUME_UP
&kp C_BRIGHTNESS_DEC  &trans  &trans  &trans  &trans  &trans    &kp LEFT                     &kp DOWN  &kp UP  &kp RIGHT                &kp RG(MINUS)  &kp C_VOL_DN
&trans                &trans  &trans  &trans  &trans  &trans    &trans                       &trans    &trans  &trans                   &trans         &kp K_MUTE
                                      &trans  &trans  &trans    &trans                       &trans    &trans
            >;
        };

        CONTROL {
            bindings = <
&kp RG(LS(NUMBER_4))  &kp RG(W)  &kp RG(S)  &trans     &kp LS(RG(Z))  &trans       &trans     &kp RG(Z)  &trans  &trans  &trans  &kp F11
&trans                &trans     &trans     &kp RC(K)  &kp RG(F)      &trans       &trans     &trans     &trans  &trans  &trans  &kp RG(SPACE)
&trans                &trans     &kp RG(X)  &trans     &trans         &trans       &trans     &trans     &trans  &trans  &trans  &trans
                                            &trans     &trans         &kp RG(S)    &kp RG(C)  &kp RG(V)  &trans
            >;

            label = "CONTROL";
        };
    };
};
