#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        bt_1 {
            bindings = <&bt BT_NXT>;
            key-positions = <1 2 3 4>;
            timeout-ms = <100>;
            require-prior-idle-ms = <250>;
        };

        bt_2 {
            bindings = <&bt BT_CLR>;
            key-positions = <28 27 26 25>;
            timeout-ms = <100>;
            require-prior-idle-ms = <250>;
        };

        cancel_term {
            bindings = <&kp LC(C)>;
            key-positions = <6 5>;
            timeout-ms = <50>;
        };
    };

    macros {
        copy_all: copy_all {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp RG(A) &kp RG(C)>;
            label = "COPY_ALL";
        };

        arrow_right: arrow_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
            label = "ARROW_RIGHT";
        };
    };

    behaviors {
        tap_dance: tap_dance {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_DANCE";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <250>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <24>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            label = "Base";
            bindings = <
&kp ESC         &kp Q  &kp W  &kp E  &kp R        &kp T       &kp Y                    &kp U            &kp I             &kp O   &kp P          &kp F18
&kp TAB         &kp A  &kp S  &kp D  &lt 3 F      &kp G       &kp H                    &kp J            &kp K             &kp L   &kp RIGHT_GUI  &kp RC(B)
&kp LEFT_SHIFT  &kp Z  &kp X  &kp C  &kp V        &kp B       &kp N                    &kp M            &trans            &trans  &trans         &sl 5
                              &sl 4  &lt 2 SPACE  &kp LALT    &mt RIGHT_COMMAND ENTER  &lt 1 BACKSPACE  &mt RCTRL DELETE
            >;
        };

        NUMBER2 {
            bindings = <
&trans  &kp COLON  &trans  &kp KP_N7        &kp KP_N8        &kp KP_N9          &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp COLON  &trans  &kp KP_N4        &kp KP_NUMBER_5  &kp KP_NUMBER_6    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp COLON  &trans  &kp KP_N1        &kp KP_N2        &kp KP_N3          &trans  &trans  &trans  &trans  &trans  &trans
                           &kp KP_NUMBER_0  &kp KP_N0        &kp DOT            &trans  &trans  &trans
            >;

            label = "NUMBER2";
        };

        SYMBOL {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            label = "SYMBOL";
            bindings = <
&kp CARET               &kp SINGLE_QUOTE   &trans  &kp LESS_THAN         &kp GREATER_THAN       &kp SLASH        &kp EXCLAMATION  &trans     &kp SEMICOLON  &trans            &trans     &kp AT
&tap_dance HASH DOLLAR  &kp DOUBLE_QUOTES  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PIPE         &kp PERIOD       &kp MINUS  &kp EQUAL      &kp PERCENT       &kp ASTRK  &kp TILDE
&kp LEFT_SHIFT          &kp GRAVE          &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp BACKSLASH    &kp QUESTION     &trans     &trans         &kp LA(NUMBER_3)  &kp COMMA  &kp AMPERSAND
                                                   &trans                &trans                 &trans           &trans           &trans     &arrow_right
            >;
        };

        UTILITY {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    |BTCLR|     | SPC |   | ENT |     | ALT |

            label = "UTILITY";
            bindings = <
&kp C_BRIGHTNESS_INC  &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans     &kp RG(PLUS)   &kp C_VOLUME_UP
&kp C_BRIGHTNESS_DEC  &trans  &trans  &trans  &trans  &trans    &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &kp RG(MINUS)  &kp C_VOL_DN
&trans                &trans  &trans  &trans  &trans  &trans    &trans    &trans    &trans  &trans     &trans         &kp K_MUTE
                                      &trans  &trans  &trans    &trans    &trans    &trans
            >;
        };

        CONTROL {
            bindings = <
&kp RG(LS(NUMBER_4))  &trans  &trans  &trans  &trans  &trans       &trans     &trans         &trans     &trans     &trans     &kp F11
&trans                &trans  &trans  &trans  &trans  &mkp MB5     &mkp MB4   &kp RA(C)      &kp LA(M)  &kp LA(N)  &kp LA(W)  &trans
&caps_word            &trans  &trans  &trans  &trans  &trans       &trans     &trans         &trans     &trans     &trans     &trans
                                      &trans  &trans  &kp RG(S)    &kp RG(Z)  &kp RG(LS(Z))  &trans
            >;

            label = "CONTROL";
        };

        CHROME {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &kp RG(NUMBER_1)  &kp RG(NUMBER_2)  &kp RG(NUMBER_3)  &kp RG(NUMBER_4)  &kp RG(N5)  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans            &kp RC(RS(TAB))   &kp RC(TAB)       &trans            &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans    &kp RG(RS(T))     &trans            &trans            &trans            &trans      &kp RG(RA(I))
                        &trans  &trans  &trans    &trans            &trans            &trans
            >;

            label = "CHROME";
        };
    };
};
